# ---- App ----
CORS_ORIGINS=["*"]

# ---- Word bank storage: "local" hoặc "r2" ----
WORDBANK_BACKEND=local
WORDBANK_LOCAL_PATH=data/words.csv

# ---- Chỉ cần điền khi WORDBANK_BACKEND=r2 ----
# Lấy trong Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-la-nguoi-giau-mat
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
WORDBANK_OBJECT_KEY=words.csv
WORDBANK_CACHE_TTL=300
