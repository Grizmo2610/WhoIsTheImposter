# ---- App ----
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO

# ---- Word bank storage: "local" | "r2" | "d1" ----
WORDBANK_BACKEND=local
WORDBANK_LOCAL_PATH=data/words.csv
WORDBANK_CACHE_TTL=300

# ---- Chỉ cần điền khi WORDBANK_BACKEND=r2 ----
# Lấy trong Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-la-nguoi-giau-mat
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
WORDBANK_OBJECT_KEY=words.csv

# ---- Chỉ cần điền khi WORDBANK_BACKEND=d1 ----
# D1_ACCOUNT_ID: Cloudflare Dashboard > góc phải trang bất kỳ (Account ID)
# D1_DATABASE_ID: Workers & Pages > D1 > chọn database > Database ID
# D1_API_TOKEN: My Profile > API Tokens > Create Token > quyền "D1 Edit"
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=
